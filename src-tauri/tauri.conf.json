{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lanzador Claude",
  "version": "0.1.0",
  "identifier": "com.ideonetworks.lanzadorclaude",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Lanzador Claude",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 640,
        "decorations": true,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "mainBinaryName": "lanzador-claude",
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEMxNDBFMkExQ0MwMUM5NzcKUldSM3lRSE1vZUpBd2VrK2Q3Y0w3aTZscFBFcUxid0lRamNFUjJUWDJuMG1oK0V6NjRJNDJ0N3QK",
      "endpoints": [
        "https://github.com/ideonetworks/lanzador-claude/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
